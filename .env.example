# SAKSHYA environment configuration
# Copy to `.env` and adjust. Never commit a real `.env`.

# ---- Application ----
SAKSHYA_ENVIRONMENT=development
SAKSHYA_APP_NAME=SAKSHYA

# ---- Authentication ----
# REQUIRED whenever SAKSHYA_ENVIRONMENT is not "development".
# The app refuses to start outside development without this set.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SAKSHYA_SECRET_KEY=
SAKSHYA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database ----
# Local prototype default (SQLite, zero setup):
SAKSHYA_DATABASE_URL=sqlite:///./sakshya.db
# PostgreSQL + pgvector target (used by docker-compose.yml):
# SAKSHYA_DATABASE_URL=postgresql+psycopg://sakshya:sakshya@db:5432/sakshya

# ---- CORS ----
SAKSHYA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI providers (Milestone 3) ----
# Left blank, the application uses the deterministic offline mock provider.
# Keys are read from the environment only and are never written to source.
# SAKSHYA_LLM_PROVIDER=mock
# SAKSHYA_ANTHROPIC_API_KEY=
# SAKSHYA_OPENAI_API_KEY=
